# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:24-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03

FROM ${NODE_IMAGE} AS development

ENV NODE_ENV=development \
    HOST=0.0.0.0 \
    PORT=3000 \
    HUSKY=0

WORKDIR /app

RUN npm install --global pnpm@11.21.0 \
    && chown node:node /app

COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-dev-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY --chown=node:node tsconfig.json tsconfig.build.json ./
COPY --chown=node:node src ./src

USER node

EXPOSE 3000

CMD ["pnpm", "dev"]
